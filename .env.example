# 飞书应用 HeroClaw
APP_ID=
APP_SECRET=

# 参与考核特约店清单（门店 / 督导 / 区域）
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=tbl0wcYNWo5mtNVf
BITABLE_VIEW_ID=vewOGEaFyE

# Web 控制台
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=9005

# 时区锁定（UTC+8 北京）
TZ=Asia/Shanghai

# NSS 周报：调度默认关闭、dry_run 默认 true（config/settings.json）
# Wiki 节点 GxQdwX094itMQ7kQyLxc0SWDnRe 已解析为下列 Base，仅 GET records
NSS_WEEKLY_BITABLE_APP_TOKEN=J0BBb0z2ua4bzEs7gumc0YQXn80
NSS_WEEKLY_BITABLE_TABLE_ID=tblc8vCaxiWyi64Y
NSS_WEEKLY_BITABLE_VIEW_ID=vewRnrIcmG
# 售后服务运营群
NSS_WEEKLY_CHAT_ID=oc_ba8af247db2e2dc4955b1d01652add82
# 下载链接基址（优先周报设置；留空生成站内相对链接），公网值仅写本机 .env
NSS_WEEKLY_LINK_BASE=
NSS_PUBLIC_BASE_URL=
# 周报输入快照与默认状态目录；不改变输出目录或提醒系统的数据目录
NSS_WEEKLY_DATA_DIR=
# 状态文件，相对上述数据目录；使用绝对路径可将状态与锁放到独立可写目录
NSS_WEEKLY_STATE_PATH=weekly_report_state.json
# sending 占用超时（正整数秒数，默认 6 小时）；超时只允许重试，不自动补发
NSS_WEEKLY_SENDING_TIMEOUT_SECONDS=21600
# 可选：DMS 门店大区只读 SQLite 快照，缺失时显示「无区域」
NSS_DMS_REGION_DB=
